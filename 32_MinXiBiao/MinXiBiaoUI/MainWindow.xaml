<Window x:Class="MinXiBiaoUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工程图明细表"
        Width="1120"
        Height="720"
        MinWidth="920"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0072BC"/>
            <Setter Property="BorderBrush" Value="#0067AA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="True"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="NoWrapCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top"
                Background="#FFFFFF"
                BorderBrush="#D8E0E8"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="标题栏位置"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="HeaderLocationCombo"
                              Width="120"
                              SelectionChanged="HeaderLocationCombo_SelectionChanged">
                        <ComboBoxItem Content="标题栏在上" Tag="above"/>
                        <ComboBoxItem Content="标题栏在下" Tag="below"/>
                    </ComboBox>
                    <TextBlock Text="文本高度"
                               VerticalAlignment="Center"
                               Margin="22,0,8,0"/>
                    <TextBox x:Name="TextHeightBox"
                             Width="72"
                             Height="28"
                             VerticalContentAlignment="Center"
                             TextChanged="TextHeightBox_TextChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid DockPanel.Dock="Bottom" Height="48" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="#5D6875"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="删除行" Click="DeleteRowsButton_Click"/>
                <Button Content="确定" Style="{StaticResource PrimaryButton}" Click="OkButton_Click"/>
                <Button Content="取消" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="PreviewGrid"/>
    </DockPanel>
</Window>

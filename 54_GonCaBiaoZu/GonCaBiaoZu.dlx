  <!-- 6. 形位公差 - 数值与基准参数 -->
  <item id="gdt_param_group" icon="styler_block_sc.bmp" name="gdt_param_group" type="uicomp" class="UGS::UICOMP_group" Expanded="1" hierarchy="" presentation="Group" ContainerItems="1">
    <PropertyList>
      <Property id="Members" mask="0" name="Members" type="array" class="UGS::UI::Comp::Container" group="Block Specific::" sname="Members" source="1" dynamic="1" hierarchy="UGS::UICOMP_group">
        <PropertyList id="ContainerItems" icon="tiles_palette.bmp" mode="1" class="UGS::UI::Comp::Container" Expanded="1" hierarchy="UGS::UICOMP_group">
          <Property id="gdt_preset" mask="256" name="gdt_preset" type="uicomp" class="UICOMP_enum" hierarchy="UGS::UICOMP_group" presentation="Enumeration">
            <item id="gdt_preset" icon="styler_optionmenu.bmp" name="gdt_preset" type="uicomp" class="UICOMP_enum" Expanded="1" hierarchy="UICOMP_enum" presentation="Enumeration">
              <PropertyList id="id" mode="0">
                <Property id="API Name" name="API Name" type="string" sname="BlockID" value="gdt_preset" source="3" ClassID="UGS::UICOMP" hierarchy="UGS::UICOMP_enum" />
                <Property id="Title" name="Title" type="utfstring" sname="Label" value="快捷模板" source="1" ClassID="UGS::UICOMP" hierarchy="UGS::UICOMP_enum" />
                <Property id="Visibility" name="Visibility" type="logical" sname="Show" value="True" source="1" ClassID="UGS::UICOMP" hierarchy="UGS::UICOMP_enum" />
                <Property id="Titles_1" name="Titles_1" type="enum" sname="Value" value="2" source="4" ClassID="UGS::UICOMP_enum" hierarchy="UGS::UICOMP_enum">
                  <Option name="— [手动自由组合]" value="0" />
                  <Option name="▱ 平面度 0.05 (精密安装面)" value="1" />
                  <Option name="▱ 平面度 0.10 (常规钣金底面)" value="2" />
                  <Option name="▱ 平面度 0.20 (大板平面度)" value="3" />
                  <Option name="⊥ 垂直度 0.10 | A (折弯边)" value="4" />
                  <Option name="⊥ 垂直度 0.20 | A (大折弯)" value="5" />
                  <Option name="⊥ 垂直度 ∅0.05 | A (孔轴线)" value="6" />
                  <Option name="∥ 平行度 0.05 | A (精密对面)" value="7" />
                  <Option name="∥ 平行度 0.10 | A (折弯对面)" value="8" />
                  <Option name="⌖ 位置度 ∅0.10 | A | B (精密孔)" value="9" />
                  <Option name="⌖ 位置度 ∅0.15 Ⓜ | A | B (压铆)" value="10" />
                  <Option name="⌖ 位置度 ∅0.20 | A | B | C" value="11" />
